# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database
DB_NAME=myproject1
DB_USER=myprojectuser
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=

# Razorpay
RAZORPAY_API_KEY=rzp_live_...
RAZORPAY_SECRET_KEY=your-razorpay-secret
WEBHOOK_SECRET=your-webhook-secret

# Google Earth Engine
# Service-account key file goes in agri_ai/gee/credentials/ (not committed — see that
# folder's contents in your own checkout) and SAR_GEE_SA_KEY below points to it with an
# absolute path.
GEE_PROJECT=your-gcp-project-id
SAR_GEE_SA_KEY=/absolute/path/to/agriculture_project_live/agri_ai/gee/credentials/your-service-account-key.json